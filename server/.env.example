# ---------------------------------------------------------------
# Pockit server configuration. Copy to .env and fill in values.
# NEVER commit .env. No bank credentials or PayPal secrets go here
# until the PayPal phase, and then only sandbox keys.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://pockit:pockit_dev_password@localhost:5432/pockit
# Set to true only for hosted databases that require SSL (e.g. Render, Neon).
DATABASE_SSL=false

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# Budget dates are calculated in this timezone.
APP_TIMEZONE=Asia/Kolkata
# Optional: freeze "today" for demos (YYYY-MM-DD). Leave empty to use the real date.
# 2026-11-16 reproduces the frontend demo data exactly.
APP_TODAY=2026-11-16

# Demo account created by `npm run db:seed`.
DEMO_EMAIL=demo@pockit.app
DEMO_PASSWORD=Pockit@123
# Allows POST /api/demo/reset (restores the demo data for the signed-in user).
ALLOW_DEMO_RESET=true

# ---------------------------------------------------------------
# Nebius Token Factory (Phase 3). Leave NEBIUS_API_KEY empty to run
# without AI: endpoints then return clearly-labelled rule-based results.
# Create a key at https://tokenfactory.nebius.com/project/api-keys
# ---------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any chat model id from `npm run ai:models`, e.g. meta-llama/Llama-3.3-70B-Instruct
NEBIUS_MODEL=
NEBIUS_TIMEOUT_MS=20000
# Set to false to switch AI off without removing the key.
AI_ENABLED=true
# Set to true to log rejected AI sentences/validation details in the server terminal (never logs the key).
AI_DEBUG=false

# ---------------------------------------------------------------
# PayPal Checkout (Orders v2). Sandbox by default.
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# and copy its Client ID and Secret here. The SECRET stays on the server; only the
# client ID is sent to the browser (it is public by design).
# Leave both empty to disable checkout (the app still works without payments).
# ---------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox: https://api-m.sandbox.paypal.com   Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=15000

# Budgets are always kept in INR. PAYPAL_CURRENCY is what PayPal is asked to CHARGE:
#   INR - only works when BOTH the sandbox merchant (business) and buyer (personal)
#         accounts are registered in India.
#   USD - PayPal charges USD at the FIXED test rate below; the rate and the USD amount
#         are shown before paying and stored on each order. The budget is still charged
#         the original rupee amount. (Never treated as an INR payment.)
PAYPAL_CURRENCY=USD
# Required only when PAYPAL_CURRENCY=USD: rupees per 1 US dollar, e.g. 88.00
PAYPAL_INR_PER_USD=90
