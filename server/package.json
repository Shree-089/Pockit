{
  "name": "pockit-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pockit REST API (Express + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/initDb.js && node scripts/seed.js",
    "test:api": "node scripts/smokeTest.js",
    "test:payments": "node scripts/paymentTest.js",
    "test:ai": "node scripts/aiUnitTest.js",
    "test:ai-live": "node scripts/aiLiveTest.js",
    "test:chat-live": "node scripts/chatLiveTest.js",
    "ai:models": "node scripts/listModels.js",
    "ai:chat-debug": "node scripts/chatDebug.js",
    "paypal:diagnose": "node scripts/paypalDiagnose.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
