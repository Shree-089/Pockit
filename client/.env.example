# Where the frontend gets its data:
#   auto = use the API if it's reachable, otherwise fall back to local mock data
#   api  = always use the API (shows a sign-in screen)
#   mock = always use local mock data (no backend needed)
VITE_DATA_SOURCE=auto

# API base URL. "/api" uses the Vite dev proxy to http://localhost:4000.
# In production, set the full backend URL, e.g. https://pockit-api.onrender.com/api
VITE_API_URL=/api
